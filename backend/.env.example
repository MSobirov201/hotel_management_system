# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_NAME=hms_db
DATABASE_USER=hms_user
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7

# Redis (Celery)
REDIS_URL=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500

# Sentry
SENTRY_DSN=your-sentry-dsn

# Frontend URL
FRONTEND_URL=http://localhost:5500




# HMS — Environment Variables (namuna)
DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

DATABASE_NAME=hms_db
DATABASE_USER=hms_user
DATABASE_PASSWORD=strong-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=7
JWT_SECRET_KEY=change-me-different-secret

FRONTEND_URL=https://your-domain.com